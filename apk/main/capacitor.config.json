{
  "appId": "com.tigomenote.app",
  "appName": "TigoMeNote",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#141418",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
