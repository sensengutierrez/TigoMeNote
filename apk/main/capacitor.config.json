{
  "appId": "com.tigomenote.app",
  "appName": "TigoMeNote",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#141418",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "launchFadeOutDuration": 200
    },
    "SystemBars": {
      "insetsHandling": "disable"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
