<?xml version="1.0" encoding="utf-8"?>
<!-- Messages widget (MALIIT, makitid: 2×2) — Pareho ang mga id sa tmn_widget_msgs.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/tmn_m_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:background="@drawable/tmn_wbg_sun">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:id="@+id/tmn_m_head" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="h:mm" android:format24Hour="HH:mm"
                android:includeFontPadding="false" android:textColor="#FFFFFFFF" android:textSize="24sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/tmn_m_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="0dp"
                android:includeFontPadding="false" android:text="—°" android:textColor="#FFFFFFFF" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:id="@+id/tmn_m_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
                android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="1dp" android:paddingBottom="1dp" android:background="@drawable/tmn_w_chip"
                android:textColor="#FFFFFFFF" android:textSize="11sp" android:textStyle="bold" android:visibility="gone" />
            </LinearLayout>
            <TextView android:id="@+id/tmn_m_cond" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end"
                    android:text="Weather" android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold" android:visibility="visible" />
        </LinearLayout>
        <FrameLayout android:id="@+id/tmn_m_tigo" android:layout_width="58dp" android:layout_height="58dp">
            <ViewFlipper android:id="@+id/tmn_m_wx" android:layout_width="match_parent" android:layout_height="match_parent" android:autoStart="true" android:flipInterval="700">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/tmn_wx_sun1" android:contentDescription="Tigo" />
            </ViewFlipper>
        </FrameLayout>
    </LinearLayout>
    <TextView android:id="@+id/tmn_m_hum" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="0dp" android:singleLine="true" android:ellipsize="end"
                    android:text="Updating…" android:textColor="#D9FFFFFF" android:textSize="11sp" />
    <LinearLayout android:id="@+id/tmn_m_bubble" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="6dp" android:paddingTop="7dp" android:paddingBottom="7dp"
        android:background="@drawable/tmn_w_bubble_quiet">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tmn_m_from" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end"
                android:textColor="#FF1C6E86" android:textSize="12sp" android:textStyle="bold" android:visibility="gone" />
            <TextView android:id="@+id/tmn_m_msg" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end"
                android:text="No new messages" android:textColor="#E6FFFFFF" android:textSize="12sp" />
        </LinearLayout>
        <ImageButton android:id="@+id/tmn_m_refresh" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="4dp" android:padding="5dp"
            android:scaleType="fitCenter" android:background="@android:color/transparent" android:contentDescription="Refresh" android:src="@android:drawable/ic_popup_sync" />
    </LinearLayout>
</LinearLayout>
