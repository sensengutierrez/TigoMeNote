<?xml version="1.0" encoding="utf-8"?>
<!-- Messages widget: kulay kapag rain (MessagesWidget.mood) + glossy na kintab sa itaas -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle">
        <gradient android:angle="315" android:startColor="#FF1C2838" android:centerColor="#FF2C425C" android:endColor="#FF46627F" />
        <corners android:radius="26dp" />
    </shape></item>
    <item><shape android:shape="rectangle">
        <gradient android:angle="270" android:startColor="#30FFFFFF" android:centerColor="#0AFFFFFF" android:centerY="0.38" android:endColor="#00FFFFFF" />
        <corners android:radius="26dp" />
        <stroke android:width="1dp" android:color="#2EFFFFFF" />
    </shape></item>
</layer-list>
