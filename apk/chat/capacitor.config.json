{
  "appId": "com.tigomenote.chat",
  "appName": "TigoMeNote Chat",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#2fb8d8",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
